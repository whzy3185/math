{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim evidence record",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "quantifiers": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_kind": {
      "enum": [
        "Observed",
        "finiteVerified",
        "analyticProved",
        "computerAssistedProved",
        "PublishedEstablished"
      ]
    },
    "verification_state": {
      "enum": [
        "unreviewed",
        "audited",
        "disputed",
        "blocked"
      ]
    },
    "novelty_status": {
      "enum": [
        "not_assessed",
        "inherited",
        "bounded_search_no_match",
        "overlap_unresolved",
        "new_contribution_proposed"
      ]
    },
    "scope_exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "formal_coverage": {
      "enum": [
        "unformalized",
        "partial",
        "formalized"
      ]
    },
    "finite_domain": {
      "type": "string",
      "minLength": 1
    },
    "primary_publication": {
      "type": "string",
      "minLength": 1
    },
    "publication_status": {
      "enum": [
        "published",
        "preprint",
        "unpublished",
        "not_applicable"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "statement",
    "hypotheses",
    "quantifiers",
    "dependencies",
    "evidence_kind",
    "verification_state",
    "novelty_status",
    "scope_exclusions",
    "formal_coverage",
    "evidence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_kind": {
            "enum": [
              "finiteVerified",
              "computerAssistedProved"
            ]
          }
        }
      },
      "then": {
        "required": [
          "finite_domain"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "evidence_kind": {
            "const": "PublishedEstablished"
          }
        }
      },
      "then": {
        "required": [
          "primary_publication"
        ]
      }
    }
  ]
}
