{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Neutral mathematical input packet",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "packet_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,99}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "enum": [
              "manuscript_source",
              "manuscript_pdf",
              "bibliography",
              "figure",
              "code",
              "data",
              "instructions",
              "provenance",
              "dependency_configuration"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "source_provenance": {
      "type": "object",
      "properties": {
        "supplement_commit": {
          "type": "string",
          "minLength": 1
        },
        "formal_baseline_commit": {
          "type": "string",
          "minLength": 1
        },
        "formal_subbundle": {
          "type": "string",
          "minLength": 1
        },
        "axiom_audit_target_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "supplement_commit",
        "formal_baseline_commit",
        "formal_subbundle",
        "axiom_audit_target_count"
      ],
      "additionalProperties": false
    },
    "source_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "upstream_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "supplied_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "upstream_sha256",
          "supplied_sha256",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "packet_id",
    "files"
  ],
  "additionalProperties": false
}
