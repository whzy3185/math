+/-- Finite rational equality verified by kernel-checked exact arithmetic. -/
+theorem r2_seed106_ldl_rat :
+    r2Seed106CoreQ - (1/50 : ℚ) • (1 : Matrix (Fin 6) (Fin 6) ℚ) =
+      r2Seed106LowerQ * Matrix.diagonal r2Seed106DiagonalQ * r2Seed106LowerQᵀ := by
+  ext i j
+  fin_cases i <;> fin_cases j <;>
+    norm_num [r2Seed106CoreQ, r2Seed106LowerQ, r2Seed106DiagonalQ,
+      Matrix.mul_apply, Matrix.vecMul, Matrix.mulVec, dotProduct, Fin.sum_univ_succ,
+      Matrix.diagonal_apply, Matrix.one_apply,
+      Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four,
+      Matrix.vecHead, Matrix.vecTail]
+
+set_option maxHeartbeats 2000000 in
+theorem r2_seed106_lower_rat : r2Seed106LowerQ.IsLowerTriangular := by decide
+
+set_option maxHeartbeats 2000000 in
+theorem r2_seed106_lower_diagonal_rat : ∀ i : Fin 6, r2Seed106LowerQ i i = 1 := by decide
+
+set_option maxHeartbeats 2000000 in
+theorem r2_seed106_diagonal_pos_rat : ∀ i : Fin 6, 0 < r2Seed106DiagonalQ i := by
+  intro i
+  fin_cases i <;> norm_num [r2Seed106DiagonalQ]
+
+noncomputable def r2Seed106Core : Matrix (Fin 6) (Fin 6) ℝ :=
+  r2Seed106CoreQ.map (Rat.castHom ℝ)
+
+noncomputable def r2Seed106Lower : Matrix (Fin 6) (Fin 6) ℝ :=
+  r2Seed106LowerQ.map (Rat.castHom ℝ)
+
+noncomputable def r2Seed106Diagonal (i : Fin 6) : ℝ := (r2Seed106DiagonalQ i : ℝ)
+
+/-- Transport the checked rational identity through the rational-to-real ring homomorphism. -/
+theorem r2_seed106_ldl_real :
+    r2Seed106Core - (1/50 : ℝ) • (1 : Matrix (Fin 6) (Fin 6) ℝ) =
+      r2Seed106Lower * Matrix.diagonal r2Seed106Diagonal * r2Seed106Lowerᵀ := by
+  let f : Matrix (Fin 6) (Fin 6) ℚ →+* Matrix (Fin 6) (Fin 6) ℝ :=
+    (Rat.castHom ℝ).mapMatrix
+  have h := congrArg f r2_seed106_ldl_rat
+  rw [map_sub, map_mul, map_mul] at h
+  have hm : f ((1/50 : ℚ) • (1 : Matrix (Fin 6) (Fin 6) ℚ)) =
+      (1/50 : ℝ) • (1 : Matrix (Fin 6) (Fin 6) ℝ) := by
+    ext i j
+    by_cases hij : i = j <;>
+      norm_num [f, RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.one_apply, hij]
+  have hd : f (Matrix.diagonal r2Seed106DiagonalQ) = Matrix.diagonal r2Seed106Diagonal := by
+    ext i j
+    by_cases hij : i = j <;>
+      simp [f, RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.diagonal_apply,
+        r2Seed106Diagonal, hij]
+  have ht : f r2Seed106LowerQᵀ = r2Seed106Lowerᵀ := rfl
+  rw [hm, hd, ht] at h
+  exact h
+
+theorem r2_seed106_diagonal_pos : ∀ i : Fin 6, 0 < r2Seed106Diagonal i := by
+  intro i
+  unfold r2Seed106Diagonal
+  exact_mod_cast (r2_seed106_diagonal_pos_rat i)
+
+theorem r2_seed106_lower_triangular : r2Seed106Lower.IsLowerTriangular := by
+  intro i j hij
+  change (r2Seed106LowerQ i j : ℝ) = 0
+  rw [r2_seed106_lower_rat hij]
+  norm_num
+
+theorem r2_seed106_lower_diagonal : ∀ i : Fin 6, r2Seed106Lower i i = 1 := by
+  intro i
+  change (r2Seed106LowerQ i i : ℝ) = 1
+  rw [r2_seed106_lower_diagonal_rat]
+  norm_num
+
+theorem r2_seed106_lower_det : r2Seed106Lower.det = 1 := by
+  rw [Matrix.det_of_isLowerTriangular _ r2_seed106_lower_triangular]
+  simp [r2_seed106_lower_diagonal]
+
+/-- Exact positive margin for the supplied normalized six-by-six n=106 seed data. -/
+theorem r2_seed106_margin_posDef :
+    (r2Seed106Core - (1/50 : ℝ) • (1 : Matrix (Fin 6) (Fin 6) ℝ)).PosDef := by
+  have hd : (Matrix.diagonal r2Seed106Diagonal).PosDef :=
+    Matrix.posDef_diagonal_iff.mpr r2_seed106_diagonal_pos
+  have hl : IsUnit r2Seed106Lower := by
+    rw [Matrix.isUnit_iff_isUnit_det, r2_seed106_lower_det]
+    exact isUnit_one
+  have hi : Function.Injective r2Seed106Lower.vecMul :=
+    Matrix.vecMul_injective_iff_isUnit.mpr hl
+  have hp := hd.mul_mul_conjTranspose_same (B := r2Seed106Lower) hi
+  rw [r2_seed106_ldl_real]
+  simpa only [Matrix.conjTranspose_eq_transpose_of_trivial] using hp
+
