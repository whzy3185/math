theorem r2_mul_four_apply {K m n : Type*} [Semiring K]
    (A : Matrix m (Fin 4) K) (B : Matrix (Fin 4) n K) (i : m) (j : n) :
    (A*B) i j = A i 0 * B 0 j +
      (A i 1 * B 1 j + (A i 2 * B 2 j + A i 3 * B 3 j)) := by
  simp [Matrix.mul_apply, Fin.sum_univ_succ]

