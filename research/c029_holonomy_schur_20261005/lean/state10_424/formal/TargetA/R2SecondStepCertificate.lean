theorem r2_second_actual_inverse : (r2Orbit ℚ 1).X⁻¹ = r2SecondInverseQ := by
  rw [r2_first_actual_orbit]
  exact Matrix.inv_eq_right_inv r2_second_inverse_product

theorem r2_second_actual_real_inverse :
    (r2Orbit ℝ 1).X⁻¹ = r2RealMatrix r2SecondInverseQ := by
  rw [r2_first_actual_real_orbit]
  exact r2_real_inverse_of_certificate _ _ r2_second_inverse_product

